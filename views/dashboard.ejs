<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>INTEC - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/nav', { activo: 'inicio' }) %>

    <div class="container pb-5">
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <a href="/estudiantes" class="text-decoration-none">
                    <div class="card shadow-sm h-100"><div class="card-body">
                        <h5 class="card-title text-primary">Estudiantes</h5>
                        <p class="card-text text-muted mb-0">Registrar, buscar y editar estudiantes.</p>
                    </div></div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/programas" class="text-decoration-none">
                    <div class="card shadow-sm h-100"><div class="card-body">
                        <h5 class="card-title text-primary">Programas</h5>
                        <p class="card-text text-muted mb-0">Valor y duración de cada técnico y tecnólogo.</p>
                    </div></div>
                </a>
            </div>
        </div>

        <h3>Usuarios del sistema</h3>
        <div class="table-responsive">
        <table class="table table-striped table-bordered bg-white">
            <thead class="table-dark">
                <tr><th>ID</th><th>Nombre</th><th>Email</th></tr>
            </thead>
            <tbody>
                <% if (usuarios.length === 0) { %>
                    <tr><td colspan="3" class="text-center">No hay usuarios registrados</td></tr>
                <% } else { %>
                    <% usuarios.forEach(usuario => { %>
                        <tr>
                            <td><%= usuario.id %></td>
                            <td><%= usuario.nombre %></td>
                            <td><%= usuario.email %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
        </div>
    </div>
</body>
</html>
