<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>INTEC - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-primary px-3">
        <span class="navbar-brand">INTEC Dashboard</span>
        <a href="/logout" class="btn btn-danger btn-sm">Cerrar Sesión</a>
    </nav>

    <div class="container mt-4">
        <h3>Lista de Usuarios (Backend Data)</h3>
        <table class="table table-striped table-bordered bg-white">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                <% if (usuarios.length === 0) { %>
                    <tr><td colspan="3" class="text-center">No hay usuarios registrados</td></tr>
                <% } else { %>
                    <% usuarios.forEach(usuario => { %>
                        <tr>
                            <td><%= usuario.id %></td>
                            <td><%= usuario.nombre %></td>
                            <td><%= usuario.email %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>