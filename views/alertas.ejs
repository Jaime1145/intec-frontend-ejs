<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>INTEC - Alertas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/nav', { activo: 'alertas' }) %>

    <%
        const etiquetas = { alto: 'Alto', medio: 'Medio', bajo: 'Bajo', preventivo: 'Preventivo' };
        const insignias = { alto: 'danger', medio: 'warning text-dark', bajo: 'info text-dark', preventivo: 'primary' };
        const bordes = { alto: 'danger', medio: 'warning', bajo: 'info', preventivo: 'primary' };
    %>
    <div class="container pb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-3">
            <div>
                <h3 class="mb-0">Alertas de pagos y riesgo de deserción</h3>
                <small class="text-muted">Calculadas con los datos de hoy (<%= fecha %>)</small>
            </div>
            <div class="text-end">
                <div class="text-muted small">Valor total en mora</div>
                <div class="fs-4 fw-bold text-danger"><%= dinero(resumen.valor_vencido) %></div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <% ['alto', 'medio', 'bajo', 'preventivo'].forEach(n => { %>
                <div class="col-6 col-md-3">
                    <a href="/alertas?nivel=<%= n %>" class="text-decoration-none">
                        <div class="card shadow-sm text-center border-<%= bordes[n] %> <%= filtro === n ? 'border-3' : '' %>">
                            <div class="card-body py-3">
                                <div class="fs-2 fw-bold text-dark"><%= resumen[n] %></div>
                                <div class="text-muted"><%= etiquetas[n] %></div>
                            </div>
                        </div>
                    </a>
                </div>
            <% }) %>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
            <div>
                <% if (filtro) { %>
                    Mostrando solo: <span class="badge bg-<%= insignias[filtro] %>"><%= etiquetas[filtro] %></span>
                    <a href="/alertas" class="ms-2">Ver todas (<%= resumen.total %>)</a>
                <% } else { %>
                    <span class="text-muted">Todas las alertas (<%= resumen.total %>). Toca un número para filtrar.</span>
                <% } %>
            </div>
            <details class="small">
                <summary class="text-primary" style="cursor:pointer">¿Cómo se calcula el riesgo?</summary>
                <div class="card card-body mt-2" style="max-width: 460px">
                    Cada situación suma puntos:
                    <ul class="mb-1">
                        <li><b>Mora</b> (cuota vencida sin pagar): 1 a 14 días = 1 · 15 a 29 = 2 · 30 a 59 = 3 · 60 o más = 4.</li>
                        <li><b>Sin ingresar a clases</b> (matrículas activas): 15 a 29 días = 2 · 30 o más = 3.</li>
                    </ul>
                    <b>Alto</b>: 4 puntos o más · <b>Medio</b>: 2 o 3 · <b>Bajo</b>: 1.<br>
                    <b>Preventivo</b>: sin riesgo, pero una cuota vence en los próximos 7 días.
                </div>
            </details>
        </div>

        <div class="table-responsive">
        <table class="table table-bordered bg-white align-middle">
            <thead class="table-dark">
                <tr><th>Riesgo</th><th>Estudiante</th><th>Programa</th><th>Motivo</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                <% if (alertas.length === 0) { %>
                    <tr><td colspan="5" class="text-center py-4">
                        <%= filtro ? 'No hay alertas en este nivel.' : 'No hay alertas. Todo está al día.' %>
                    </td></tr>
                <% } else { %>
                    <% alertas.forEach(a => { %>
                        <tr>
                            <td><span class="badge bg-<%= insignias[a.nivel] %>"><%= etiquetas[a.nivel] %></span></td>
                            <td>
                                <%= a.apellidos %> <%= a.nombres %>
                                <br><small class="text-muted"><%= a.documento %></small>
                            </td>
                            <td>
                                <%= a.programa %>
                                <br><small class="text-muted"><%= a.nivel_programa === 'tecnologo' ? 'Tecnólogo' : 'Técnico' %> · <%= a.periodo %></small>
                            </td>
                            <td>
                                <% a.motivos.forEach(m => { %><div><%= m %></div><% }) %>
                            </td>
                            <td class="text-nowrap">
                                <% if (a.whatsapp) { %>
                                    <a class="btn btn-sm btn-success" href="<%= a.whatsapp %>" target="_blank" rel="noopener">WhatsApp</a>
                                <% } else { %>
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="Sin celular válido">WhatsApp</button>
                                <% } %>
                                <% if (a.correo) { %>
                                    <a class="btn btn-sm btn-outline-primary" href="<%= a.correo %>">Correo</a>
                                <% } else { %>
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="Sin correo">Correo</button>
                                <% } %>
                                <a class="btn btn-sm btn-outline-dark" href="/matriculas/<%= a.matricula_id %>">Ver</a>
                                <% if (a.estado === 'activa') { %>
                                    <form class="d-inline" method="POST" action="/matriculas/<%= a.matricula_id %>/acceso"
                                          onsubmit="return confirm('¿Registrar que este estudiante ingresó hoy a clases?');">
                                        <input type="hidden" name="volver" value="alertas">
                                        <button class="btn btn-sm btn-outline-secondary">Registrar ingreso</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
        </div>
    </div>
</body>
</html>
