<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>INTEC - Editar estudiante</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/nav', { activo: 'estudiantes' }) %>

    <div class="container pb-5" style="max-width: 760px;">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Editar estudiante</div>
            <div class="card-body">
                <form method="POST" action="/estudiantes/<%= e.id %>" class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">Tipo doc.</label>
                        <select name="tipo_documento" class="form-select">
                            <% ['CC','TI','CE','PPT','PASAPORTE'].forEach(t => { %>
                                <option <%= e.tipo_documento === t ? 'selected' : '' %>><%= t %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Documento *</label>
                        <input name="documento" class="form-control" value="<%= e.documento %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nombres *</label>
                        <input name="nombres" class="form-control" value="<%= e.nombres %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos *</label>
                        <input name="apellidos" class="form-control" value="<%= e.apellidos %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <input name="email" type="email" class="form-control" value="<%= e.email || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Teléfono</label>
                        <input name="telefono" class="form-control" value="<%= e.telefono || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ciudad</label>
                        <input name="ciudad" class="form-control" value="<%= e.ciudad || '' %>">
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary">Guardar cambios</button>
                        <a href="/estudiantes" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
