<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>INTEC - Matrículas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/nav', { activo: 'matriculas' }) %>

    <%
        const colores = { pendiente: 'warning text-dark', activa: 'success', retirada: 'secondary', graduada: 'primary' };
    %>
    <div class="container pb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Matrículas (<%= matriculas.length %>)</h3>
            <a href="/matriculas/nueva" class="btn btn-primary">+ Nueva matrícula</a>
        </div>

        <div class="table-responsive">
        <table class="table table-striped table-bordered bg-white align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th><th>Estudiante</th><th>Programa</th><th>Periodo</th>
                    <th>Estado</th><th class="text-end">Pagado</th><th class="text-end">Pendiente</th><th></th>
                </tr>
            </thead>
            <tbody>
                <% if (matriculas.length === 0) { %>
                    <tr><td colspan="8" class="text-center">Aún no hay matrículas</td></tr>
                <% } else { %>
                    <% matriculas.forEach(m => { %>
                        <tr>
                            <td><%= m.id %></td>
                            <td><%= m.apellidos %> <%= m.nombres %><br><small class="text-muted"><%= m.documento %></small></td>
                            <td><%= m.programa %><br><small class="text-muted"><%= m.nivel === 'tecnologo' ? 'Tecnólogo' : 'Técnico' %></small></td>
                            <td><%= m.periodo %></td>
                            <td><span class="badge bg-<%= colores[m.estado] || 'secondary' %>"><%= m.estado %></span></td>
                            <td class="text-end"><%= dinero(m.total_pagado) %></td>
                            <td class="text-end"><%= dinero(m.total_pendiente) %></td>
                            <td><a class="btn btn-sm btn-outline-primary" href="/matriculas/<%= m.id %>">Ver</a></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
        </div>
    </div>
</body>
</html>
